+#define YTPHY_MDIO_ADDRESS_CTRL_REG		0xA005
+#define YTPHY_MACR_EN_ADDRESS_0			BIT(6)
+
 #define YTPHY_MISC_CONFIG_REG			0xA006
 #define YTPHY_MCR_FIBER_SPEED_MASK		BIT(0)
