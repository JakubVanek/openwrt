+
 	ret = yt8821_serdes_init(phydev);
 	if (ret < 0)
 		return ret;
@@ -2700,6 +2721,20 @@
 }
 
 /**
+ * yt8821_probe() - early PHY initialization
+ * @phydev: a pointer to a &struct phy_device
+ *
+ * Returns: 0 or negative errno code
+ */
+static int yt8821_probe(struct phy_device *phydev)
+{
+	/* Disable listening on MDIO address 0 to stop the MT7981B
+	 * internal gigabit PHY driver from corrupting the internal
+	 * state of the YT8821 */
+	return yt8821_disable_mdio_address_zero(phydev);
+}
