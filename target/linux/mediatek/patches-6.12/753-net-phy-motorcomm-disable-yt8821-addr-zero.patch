 /**
+ * yt8821_disable_mdio_broadcast() - disable listening on MDIO address 0
+ * @phydev: a pointer to a &struct phy_device
+ *
+ * Returns: 0 or negative errno code
+ */
+static int yt8821_disable_mdio_address_zero(struct phy_device *phydev)
+{
+	return ytphy_modify_ext(phydev,
+				YTPHY_MDIO_ADDRESS_CTRL_REG,
+				YTPHY_MACR_EN_ADDRESS_0,
+				0);
+}
